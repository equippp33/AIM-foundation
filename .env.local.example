# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored — never commit real credentials.

# Amazon SES SMTP credentials (SES console → SMTP settings → Create SMTP credentials).
# SES_USER is the SMTP username (looks like AKIA...), SES_PASSWORD is the generated SMTP password.
SES_USER=your_ses_smtp_username
SES_PASSWORD=your_ses_smtp_password

# Verified sender (an email or domain you have verified in SES).
SENDER_EMAIL=info@yourdomain.com

# SES SMTP endpoint — set to the AWS region where your SES identity is verified.
# e.g. email-smtp.us-east-1.amazonaws.com | email-smtp.ap-south-1.amazonaws.com | email-smtp.eu-west-1.amazonaws.com
SES_HOST=email-smtp.us-east-1.amazonaws.com
SES_PORT=587

# Supabase (server reads the donor records with the service-role key).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Admin dashboard login (/admin/login). Password gates access to donor records.
# ADMIN_SESSION_SECRET signs the session cookie — set a long random string in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_strong_password
ADMIN_SESSION_SECRET=set_a_long_random_string_here
